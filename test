    local unstable = function()
        failCount = failCount + 1
        if failCount < 3 then error("fail") end
        return "ok"
    end
    local retried = withRetry(unstable, 5)
    local res = retried()
    assert(res == "ok" and failCount == 3)
end)

_test("truthiness short circuit nil coalescing", function()
    local function id(x) return x end
    assert(id(nil) == nil); assert(id(false) == false)
    assert(id(0) == 0); assert(id("") == "")
    local function ternary(cond, t, f)
        if cond then return t else return f end
    end
    assert(ternary(true, 1, 2) == 1); assert(ternary(false, 1, 2) == 2)
    assert(ternary(0, "yes", "no") == "yes"); assert(ternary(nil, "yes", "no") == "no")
    assert(ternary("", "yes", "no") == "yes")
    local x = nil
    assert((x or "default") == "default")
    x = false; assert((x or "default") == "default")
    x = 0; assert((x or "default") == 0)
    x = ""; assert((x or "default") == "")
    local function safeDivide(a, b) return b ~= 0 and a/b or 0 end
    assert(safeDivide(10, 2) == 5); assert(safeDivide(10, 0) == 0)
    local t = nil
    local safe = t and t.value or "nil_table"
    assert(safe == "nil_table")
    t = {value = 42}
    safe = t and t.value or "nil_table"
    assert(safe == 42)
end)

_test("binary search tree", function()
    local BTree = {}; BTree.__index = BTree
    function BTree.new(val) return setmetatable({val=val, left=nil, right=nil}, BTree) end
    function BTree:insert(val)
        if val < self.val then
            if self.left then self.left:insert(val) else self.left = BTree.new(val) end
        else
            if self.right then self.right:insert(val) else self.right = BTree.new(val) end
        end
    end
    function BTree:inorder(result)
        result = result or {}
        if self.left then self.left:inorder(result) end
        result[#result+1] = self.val
        if self.right then self.right:inorder(result) end
        return result
    end
    function BTree:contains(val)
        if val == self.val then return true end
        if val < self.val then return self.left ~= nil and self.left:contains(val) end
        return self.right ~= nil and self.right:contains(val)
    end
    local tree = BTree.new(5)
    for _, v in ipairs({3, 7, 1, 4, 6, 8, 2}) do tree:insert(v) end
    local sorted = tree:inorder()
    assert(#sorted == 8)
    for i = 1, #sorted-1 do assert(sorted[i] < sorted[i+1]) end
    assert(tree:contains(1) and tree:contains(8) and tree:contains(5))
    assert(not tree:contains(9) and not tree:contains(0))
end)

