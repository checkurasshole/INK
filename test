local function _test(name, fn)
    _total = _total + 1
    local ok, err = pcall(fn)
    if ok then
        _passed = _passed + 1
    else
        _results[#_results + 1] = "[FAIL] " .. name .. ": " .. tostring(err)
    end
end

-- helper: compile a chunk at runtime so 5.1-incompatible syntax won't crash the parser
local function loadchunk(src, ...)
    local args = {...}
    local fn = load(src)
    if not fn then return nil end
    return fn(unpack(args))
end

