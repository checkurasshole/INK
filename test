_test("table library functions", function()
    local t = {1, 2, 3}
    table.insert(t, 4)
    assert(#t == 4 and t[4] == 4)
    table.insert(t, 1, 0)
    assert(t[1] == 0 and t[2] == 1)
    local removed = table.remove(t)
    assert(removed == 4)
    removed = table.remove(t, 1)
    assert(removed == 0 and t[1] == 1)
    local sorted = {3, 1, 4, 1, 5, 9, 2, 6}
    table.sort(sorted)
    assert(sorted[1] == 1 and sorted[#sorted] == 9)
    table.sort(sorted, function(a, b) return a > b end)
    assert(sorted[1] == 9 and sorted[#sorted] == 1)
    local concat_t = {"a", "b", "c", "d"}
    assert(table.concat(concat_t, ",") == "a,b,c,d")
    assert(table.concat(concat_t, "-", 2, 3) == "b-c")
    if table.move then
        local src = {1,2,3,4,5}
        local dst = {10,20,30}
        table.move(src, 1, 3, 2, dst)
        assert(dst[2] == 1 and dst[3] == 2 and dst[4] == 3)
    end
    if table.pack then
        local packed = table.pack(10, 20, 30)
        assert(packed.n == 3 and packed[1] == 10)
    end
    local _unpack = table.unpack or unpack
    if _unpack then
        local vals = {_unpack({5,6,7})}
        assert(vals[1] == 5 and vals[2] == 6 and vals[3] == 7)
    end
end)

_test("function features variadics closures", function()
    local function f1() return 1 end
    local function f2(x) return x * 2 end
    local function f3(x, y) return x + y end
    local function f4(x, y, z) return x, y, z end
    local function f5(...) return ... end
    local function f6(...) local t = {...}; return #t end
    local function f7(...) return select("#", ...) end
    local function f8(...) return select(2, ...) end
    local function f9(a, b, ...) return a + b, ... end
    assert(f1() == 1)
    assert(f2(5) == 10)
    assert(f3(3, 4) == 7)
    local r1, r2, r3 = f4(1, 2, 3)
    assert(r1 == 1 and r2 == 2 and r3 == 3)
    local s1, s2, s3 = f5(7, 8, 9)
    assert(s1 == 7 and s2 == 8 and s3 == 9)
    assert(f6(1,2,3,4,5) == 5)
    assert(f7(1,2,3) == 3)
    local v2, v3 = f8(1,2,3)
    assert(v2 == 2 and v3 == 3)
    local sum, rest1, rest2 = f9(10, 20, 30, 40)
    assert(sum == 30 and rest1 == 30 and rest2 == 40)
    local anon = function(x) return x ^ 2 end
    assert(anon(4) == 16)
    local function fact(n)
        if n <= 1 then return 1 end
        return n * fact(n - 1)
    end
    assert(fact(10) == 3628800)
    local function fib(n)
        if n < 2 then return n end
        return fib(n-1) + fib(n-2)
    end
    assert(fib(10) == 55)
    local function makeCounter(start)
        local count = start or 0
        return function() count = count + 1; return count end
    end
    local counter = makeCounter(0)
    assert(counter() == 1)
    assert(counter() == 2)
    assert(counter() == 3)
    local counter2 = makeCounter(10)
    assert(counter2() == 11)
    assert(counter() == 4)
    local function makeAdder(x)
        return function(y) return x + y end
    end
    local add5 = makeAdder(5)
    local add10 = makeAdder(10)
    assert(add5(3) == 8)
    assert(add10(3) == 13)
    local upval = 0
    local function inc() upval = upval + 1 end
    local function get() return upval end
    inc(); inc(); inc()
    assert(get() == 3)
    local function multiReturn() return 1, 2, 3, 4, 5 end
    local t = {multiReturn()}
    assert(#t == 5)
    local only1 = (multiReturn())
    assert(only1 == 1)
    local function variadicSum(...)
        local sum = 0
        for _, v in ipairs({...}) do sum = sum + v end
        return sum
    end
    assert(variadicSum(1,2,3,4,5) == 15)
    assert(variadicSum() == 0)
    local tbl_func = {}
    tbl_func.method = function(self, x) return self.value + x end
    tbl_func.value = 100
    assert(tbl_func:method(50) == 150)
    assert(tbl_func.method(tbl_func, 50) == 150)
end)

_test("control flow if while repeat for break", function()
    local x = 10
    if x > 5 then assert(true) end
    if x > 100 then assert(false) else assert(true) end
    if x < 0 then assert(false) elseif x < 5 then assert(false) elseif x < 15 then assert(true) else assert(false) end
    local result = x > 5 and "big" or "small"
    assert(result == "big")
    local sum = 0
    local i = 1
    while i <= 10 do sum = sum + i; i = i + 1 end
    assert(sum == 55)
    sum = 0; i = 1
    repeat sum = sum + i; i = i + 1 until i > 10
    assert(sum == 55)
    sum = 0
    for i = 1, 10 do sum = sum + i end
    assert(sum == 55)
    sum = 0
    for i = 1, 10, 2 do sum = sum + i end
    assert(sum == 25)
    sum = 0
    for i = 10, 1, -1 do sum = sum + i end
    assert(sum == 55)
    sum = 0
    for i = 1, 10 do if i == 5 then break end; sum = sum + i end
    assert(sum == 10)
    local t = {10, 20, 30, 40, 50}
    sum = 0
    for i, v in ipairs(t) do sum = sum + v end
    assert(sum == 150)
    local dict = {a=1, b=2, c=3}
    sum = 0
    for k, v in pairs(dict) do sum = sum + v end
    assert(sum == 6)
    local function statefulIter(max)
        local i = 0
        return function()
            i = i + 1
            if i <= max then return i end
        end
    end
    local collected = {}
    for v in statefulIter(5) do collected[#collected+1] = v end
    assert(#collected == 5 and collected[5] == 5)
    local nested_sum = 0
    for i = 1, 3 do for j = 1, 3 do nested_sum = nested_sum + i * j end end
    assert(nested_sum == 36)
end)

_test("goto statement", function()
    -- wrap in load: goto is not valid syntax in Lua 5.1
    local chunk = load([[
        local x = 1
        if x == 1 then goto done end
        assert(false)
        ::done::
        assert(true)

        local i = 0
        ::loop_start::
        i = i + 1
        if i < 5 then goto loop_start end
        assert(i == 5)

        local sum = 0
        for i = 1, 10 do
            if i % 2 == 0 then goto skip end
            sum = sum + i
            ::skip::
        end
        assert(sum == 25)

        do
            local result = 0
            for i = 1, 5 do
                for j = 1, 5 do
                    if i == 3 and j == 3 then goto break_all end
                    result = result + 1
                end
            end
            ::break_all::
            assert(result == 12)
        end
    ]])
    if not chunk then return end -- skip on Lua 5.1
    chunk()
end)

_test("pcall xpcall error handling", function()
    local ok, err = pcall(function() error("test error") end)
    assert(not ok)
    assert(type(err) == "string")
    ok = pcall(function() return 1 + 1 end)
    assert(ok)
    ok, err = pcall(function() error({code = 404, msg = "not found"}) end)
    assert(not ok)
    assert(type(err) == "table")
    assert(err.code == 404)
    ok, err = pcall(function() error("level 0", 0) end)
    assert(not ok)
    assert(err == "level 0")
    ok, err = pcall(function() error(nil) end)
    assert(not ok)
    local function handler(e) return {handled = true, original = e} end
    ok, err = xpcall(function() error("xpcall test") end, handler)
    assert(not ok)
    assert(err.handled == true)
    ok, err = xpcall(function() return 42 end, handler)
    assert(ok and err == 42)
    local success, result = pcall(function()
        local t = nil
        return t.field
    end)
    assert(not success)
    success, result = pcall(function()
        local n = "string"
        return n + 1
    end)
    assert(not success)
    local function risky(v)
        if v < 0 then error("negative: " .. v) end
        return math.sqrt(v)
    end
    ok, result = pcall(risky, 4)
    assert(ok and result == 2)
    ok, result = pcall(risky, -1)
    assert(not ok)
end)

