        local n = #a; local m = #b[1]; local p = #b
        for i = 1, n do
            result[i] = {}
            for j = 1, m do
                local sum = 0
                for k = 1, p do sum = sum + a[i][k] * b[k][j] end
                result[i][j] = sum
            end
        end
        return result
    end
    local A = {{1,2},{3,4}}; local B = {{5,6},{7,8}}
