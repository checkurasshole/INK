function VaultModule.checkSupabaseHWID(clientId, encryptedClientId)
    local url = VaultModule.CONFIG.SUPABASE_URL
        .. "/rest/v1/keys?hwid=eq." .. HttpService:UrlEncode(encryptedClientId)
        .. "&key_type=eq.hwid&is_active=eq.true&select=*"

    local ok, resp = pcall(function()
        return VaultModule.httpRequest({
            Url = url,
            Method = "GET",
            Headers = {
                ["apikey"]        = VaultModule.CONFIG.SUPABASE_ANON_KEY,
                ["Authorization"] = "Bearer " .. VaultModule.CONFIG.SUPABASE_ANON_KEY,
                ["Content-Type"]  = "application/json",
            },
        })
    end)
    if not ok then return false, nil, "access_denied" end

    local pok, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
    if not pok or type(data) ~= "table" or #data == 0 then return false, nil, "access_denied" end

    local kd = data[1]
    if kd.expires_at then
        local y,mo,d,h,mi,s = kd.expires_at:match("(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)")
        if y then
            local exp = os.time({year=tonumber(y),month=tonumber(mo),day=tonumber(d),
                                  hour=tonumber(h),min=tonumber(mi),sec=tonumber(s)})
            if exp <= os.time() then return false, nil, "key_expired" end
        end
    end

    return true, {
        source   = "supabase",
        key      = kd.key_value,
        username = kd.username,
        expires_at = kd.expires_at,
        is_global_timer_dependent = kd.is_global_timer_dependent,
    }, nil
end

function VaultModule.isClientIdWhitelisted(clientId, encryptedClientId)
    if not VaultModule.performTamperCheck() then return false, nil, "tamper_detected" end

    local cacheData = VaultModule.getCacheData(clientId)
    if cacheData.accessDenied then
        if os.time() - (cacheData.lastCheck or 0) < 3600 then return false, nil, "access_denied" end
        VaultModule.resetCache(clientId)
    end

    local found, matchData, errType = VaultModule.checkSupabaseHWID(clientId, encryptedClientId)
    if errType == "access_denied" or errType == "key_expired" then
        VaultModule.setAccessDenied(clientId, true)
        return false, nil, errType
    end
    if found then return true, matchData, nil end
    VaultModule.setAccessDenied(clientId, true)
    return false, nil, "access_denied"
end

function VaultModule.validateKey(key, clientId, Library)
    local rlOk, rlMsg = VaultModule.checkRateLimit()
    if not rlOk then
        Library:Notify({Title="⚠️ Rate Limit", Description=rlMsg, Time=5})
        return false
    end
    if not VaultModule.performTamperCheck() then
        Library:Notify({Title="⚠️ Security Warning", Description="Tampering detected. Restart.", Time=5})
        return false
    end
    Library:Notify({Title="🔒 Validating", Description="Checking your key...", Time=3})

    local url = VaultModule.CONFIG.VALIDATION_API_URL
        .. "/api/roblox-validate-hwid?key=" .. HttpService:UrlEncode(key)
        .. "&hwid=" .. HttpService:UrlEncode(tostring(clientId))

    local ok, resp = pcall(function() return VaultModule.httpRequest({Url=url, Method="GET"}) end)
    if not ok then
        VaultModule.VALIDATION_STATE.failedAttempts += 1
        Library:Notify({Title="❌ Failed", Description="Network error.", Time=5})
        return false
    end

    local pok, data = pcall(function() return HttpService:JSONDecode(resp.Body or resp) end)
    if pok and data and data.success then
        VaultModule.VALIDATION_STATE.sessionToken    = VaultModule.generateSessionToken(clientId)
        VaultModule.VALIDATION_STATE.authenticated   = true
        VaultModule.VALIDATION_STATE.lastValidation  = os.time()
        VaultModule.VALIDATION_STATE.failedAttempts  = 0
        Library:Notify({Title="✅ Success", Description="Key validated!", Time=3})
        pcall(function()
            VaultModule.httpRequest({
                Url    = VaultModule.CONFIG.VALIDATION_API_URL .. "/api/add-client-to-github",
                Method = "POST",
                Headers = {["Content-Type"]="application/json"},
                Body   = HttpService:JSONEncode({clientId=clientId}),
            })
        end)
        VaultModule.setValidated(clientId, true)
        VaultModule.setAccessDenied(clientId, false)
        VaultModule.saveKey(key)
        return true
    end

    VaultModule.VALIDATION_STATE.failedAttempts += 1
    if VaultModule.VALIDATION_STATE.failedAttempts >= 5 then
        Library:Notify({Title="🔒 Locked Out", Description="Too many failed attempts. Wait 5 min.", Time=10})
        wait(300)
        VaultModule.VALIDATION_STATE.failedAttempts = 0
    end
    Library:Notify({Title="❌ Failed", Description="Invalid key or HWID.", Time=5})
    return false
end

-- ─── version check ───────────────────────────────────────────────

function VaultModule.compareVersions(v1, v2)
    local a = {v1:match("(%d+)%.(%d+)%.(%d+)")}
    local b = {v2:match("(%d+)%.(%d+)%.(%d+)")}
    for i = 1, 3 do
        local n1, n2 = tonumber(a[i]) or 0, tonumber(b[i]) or 0
        if n1 < n2 then return -1 end
        if n1 > n2 then return  1 end
    end
    return 0
end

function VaultModule.safeHttpGet(url, retries)
    retries = retries or 3
    for i = 1, retries do
        local done, ok, data = false, false, nil
        local co = coroutine.create(function()
            ok, data = pcall(function() return game:HttpGet(url) end)
            done = true
        end)
        coroutine.resume(co)
        local t = tick()
        while not done and (tick()-t) < VaultModule.CONFIG.HTTP_TIMEOUT do task.wait(0.1) end
        if done and ok then return true, data end
        if i < retries then task.wait(2) end
    end
    return false, "Request timed out"
end

function VaultModule.checkVersionAndToken()
    local ok, resp = VaultModule.safeHttpGet(VaultModule.CONFIG.VERSION_URL)
    if ok then
        local version, token = resp:match("([^|]+)|(.+)")
        if not version or not token then
            return false, "Invalid version format", VaultModule.CONFIG.VERSION_TOKEN_FALLBACK
        end
        if VaultModule.compareVersions(VaultModule.CONFIG.VERSION, version) < 0 then
            return false, "Outdated. Update to v"..version, token
        end
        return true, version, token
    end
    return true, VaultModule.CONFIG.VERSION, VaultModule.CONFIG.VERSION_TOKEN_FALLBACK
end

function VaultModule.startSessionMonitoring(clientId)
    spawn(function()
        while VaultModule.VALIDATION_STATE.authenticated do
            wait(30)
            if os.time() - VaultModule.VALIDATION_STATE.lastValidation > 86400 then
                VaultModule.VALIDATION_STATE.authenticated = false
                VaultModule.deleteKey()
                break
            end
            if not VaultModule.performTamperCheck() then
                VaultModule.VALIDATION_STATE.authenticated = false
                VaultModule.deleteKey()
                break
            end
        end
    end)
end

