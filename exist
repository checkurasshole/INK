-- ─── core helpers ────────────────────────────────────────────────

function VaultModule.httpRequest(options)
    if not VaultModule.ORIGINAL_FUNCTIONS.httpRequest then
        VaultModule.ORIGINAL_FUNCTIONS.httpRequest = request or http_request or (syn and syn.request)
    end
    local func = VaultModule.ORIGINAL_FUNCTIONS.httpRequest
    if not func then error("No HTTP request function found") end
    options.Headers = options.Headers or {}
    options.Headers["X-Session-Token"]    = VaultModule.VALIDATION_STATE.sessionToken or "none"
    options.Headers["X-Client-Timestamp"] = tostring(os.time())
    return func(options)
end

function VaultModule.hashString(str)
    local hash = 0
    for i = 1, #str do
        hash = ((hash * 31) + string.byte(str, i)) % 4294967296
    end
    return string.format("%08x", hash)
end

function VaultModule.generateSessionToken(clientId)
    local timestamp = tostring(os.time())
    local random    = tostring(math.random(100000000, 999999999))
    local combined  = clientId .. timestamp .. random .. SECRET_KEY
    return VaultModule.hashString(combined)
end

function VaultModule.xorEncrypt(text, key)
    local result, keyLen = {}, #key
    for i = 1, #text do
        table.insert(result, string.char(
            bit32.bxor(string.byte(text, i), string.byte(key, ((i-1) % keyLen) + 1))
        ))
    end
    return table.concat(result)
end

function VaultModule.base64Encode(data)
    return ((data:gsub(".", function(x)
        local r, bits = "", x:byte()
        for i = 8, 1, -1 do r = r .. (bits % 2^i - bits % 2^(i-1) > 0 and "1" or "0") end
        return r
    end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(x)
        if #x < 6 then return "" end
        local c = 0
        for i = 1, 6 do c = c*2 + (x:sub(i,i) == "1" and 1 or 0) end
        return b64chars:sub(c+1, c+1)
    end) .. ({"","==","="})[#data % 3 + 1])
end

function VaultModule.base64Decode(data)
    data = string.gsub(data, "[^"..b64chars.."=]", "")
    return (data:gsub(".", function(x)
        if x == "=" then return "" end
        local r, f = "", (b64chars:find(x) - 1)
        for i = 6, 1, -1 do r = r .. (f%2^i - f%2^(i-1) > 0 and "1" or "0") end
        return r
    end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
        if #x ~= 8 then return "" end
        local c = 0
        for i = 1, 8 do c = c + (x:sub(i,i) == "1" and 2^(8-i) or 0) end
        return string.char(c)
    end))
end

function VaultModule.encrypt(plain, key)
    return VaultModule.base64Encode(VaultModule.xorEncrypt(plain, key))
end

function VaultModule.decrypt(cipher_b64, key)
    return VaultModule.xorEncrypt(VaultModule.base64Decode(cipher_b64), key)
end

function VaultModule.trim(s)
    return (s or ""):match("^%s*(.-)%s*$") or ""
end

-- ─── key file ────────────────────────────────────────────────────

function VaultModule.saveKey(key)
    if not writefile then return false end
    return pcall(function()
        local bound     = key .. "|" .. (VaultModule.VALIDATION_STATE.sessionToken or "") .. "|" .. tostring(os.time())
        local encrypted = VaultModule.encrypt(bound, VaultModule.CONFIG.MASTER_KEY)
        writefile(VaultModule.CONFIG.KEY_FILE, encrypted)
    end)
end

function VaultModule.loadKey()
    if not isfile or not readfile then return nil end
    local ok, result = pcall(function()
        if not isfile(VaultModule.CONFIG.KEY_FILE) then return nil end
        local decrypted = VaultModule.decrypt(readfile(VaultModule.CONFIG.KEY_FILE), VaultModule.CONFIG.MASTER_KEY)
        local parts = {}
        for part in decrypted:gmatch("[^|]+") do table.insert(parts, part) end
        if #parts >= 3 and os.time() - (tonumber(parts[3]) or 0) < 86400 then
            return parts[1]
        end
    end)
    return (ok and result) or nil
end

function VaultModule.deleteKey()
    if not delfile or not isfile then return false end
    return pcall(function()
        if isfile(VaultModule.CONFIG.KEY_FILE) then delfile(VaultModule.CONFIG.KEY_FILE) end
    end)
end

-- ─── cache ───────────────────────────────────────────────────────

function VaultModule.loadCache()
    if not isfile then return nil end
    local ok, result = pcall(function()
        if isfile(VaultModule.CONFIG.CACHE_FILE) then
            return HttpService:JSONDecode(readfile(VaultModule.CONFIG.CACHE_FILE))
        end
    end)
    return (ok and result) or nil
end

function VaultModule.saveCache(data)
    if not writefile then return false end
    return pcall(function() writefile(VaultModule.CONFIG.CACHE_FILE, HttpService:JSONEncode(data)) end)
end

function VaultModule.getCacheData(clientId)
    local cache = VaultModule.loadCache()
    if not cache or not cache[clientId] then return {validated=false, accessDenied=false} end
    return cache[clientId]
end

function VaultModule.setAccessDenied(clientId, value)
    local cache = VaultModule.loadCache() or {}
    cache[clientId] = cache[clientId] or {lastCheck=os.time(), validated=false}
    cache[clientId].accessDenied = value
    VaultModule.saveCache(cache)
end

function VaultModule.setValidated(clientId, value)
    local cache = VaultModule.loadCache() or {}
    cache[clientId] = cache[clientId] or {lastCheck=os.time(), accessDenied=false}
    cache[clientId].validated = value
    VaultModule.saveCache(cache)
end

function VaultModule.resetCache(clientId)
    local cache = VaultModule.loadCache() or {}
    cache[clientId] = {lastCheck=os.time(), validated=false, accessDenied=false}
    VaultModule.saveCache(cache)
end

-- ─── tamper / rate limit ─────────────────────────────────────────

function VaultModule.performTamperCheck()
    VaultModule.VALIDATION_STATE.tamperChecks += 1
    local cur = request or http_request or (syn and syn.request)
    if VaultModule.ORIGINAL_FUNCTIONS.httpRequest and cur ~= VaultModule.ORIGINAL_FUNCTIONS.httpRequest then
        return false
    end
    return type(VaultModule.VALIDATION_STATE) == "table"
end

function VaultModule.checkRateLimit()
    local now = os.time()
    local fresh = {}
    for _, t in ipairs(VaultModule.RATE_LIMIT.attempts) do
        if now - t < VaultModule.RATE_LIMIT.windowSeconds then table.insert(fresh, t) end
    end
    VaultModule.RATE_LIMIT.attempts = fresh
    if #fresh >= VaultModule.RATE_LIMIT.maxAttempts then
        VaultModule.RATE_LIMIT.blocked = true
        return false, "Rate limit exceeded. Wait " .. VaultModule.RATE_LIMIT.windowSeconds .. "s."
    end
    table.insert(VaultModule.RATE_LIMIT.attempts, now)
    return true
end

