-- free session async (mirrors doc 3 status flow exactly)
task.spawn(function()
    for i = 5, 1, -1 do
        statusLabel:SetText(string.format("Loading in %ds...", i))
        task.wait(1)
    end
    statusLabel:SetText("Authenticating...")

    local result = checkSession(hwid)

    if result == nil then
        statusLabel:SetText("Status: Failed")
        Library:Notify({Title="COMBOWICK", Description="Session check failed.", Time=5})

    elseif result.status == "allowed" or result.status == "session_active" then
        local token = result.session_token
        if type(token) ~= "string" or #token < 20 then
            statusLabel:SetText("Status: Failed")
        else
            statusLabel:SetText("Status: Authenticated!")
            Library:Notify({Title="COMBOWICK", Description="Authenticated!", Time=3})
            local remaining = tonumber(result.remaining) or 0
            task.spawn(function()
                while remaining > 0 do
                    local fmt = formatTime(remaining)
                    timerLabel:SetText(string.format("Session: %s left", fmt))
                    lSession:SetText(string.format("Session time: %s", fmt))
                    task.wait(1)
                    remaining -= 1
                end
                timerLabel:SetText("Session expired. Re-execute.")
                lSession:SetText("Session time: expired")
                -- Reload the exist script to show GUI again
                local ok, s = pcall(function() return game:HttpGet(EXIST_URL) end)
                if ok and s and #s > 0 then pcall(loadstring(s)) end
                _G.COMBOWICK_ACTIVE = false
                task.wait(0.5)
                Library:Unload()
            end)
            _G.COMBOWICK_FREE   = true
            _G.COMBOWICK_ACTIVE = true
            local scriptUrl = getScriptForGame(token)
            if loadFreeScript(scriptUrl, token) then task.wait(2) Library:Unload() end
        end

    elseif result.status == "cooldown" then
        local remaining = tonumber(result.remaining) or 0
        statusLabel:SetText("On Cooldown")
        hintLabel:SetText("Get an 11hr key or wait it out.")
        Library:Notify({Title="COMBOWICK", Description="On cooldown! Get a key to skip.", Time=6})
        task.spawn(function()
            while remaining > 0 do
                local fmt = formatTime(remaining)
                timerLabel:SetText(string.format("Cooldown: %s", fmt))
                lCooldown:SetText(string.format("Cooldown: %s", fmt))
                task.wait(1)
                remaining -= 1
            end
            timerLabel:SetText("Cooldown done! Re-execute.")
            lCooldown:SetText("Cooldown: done")
            hintLabel:SetText("")
            Library:Notify({Title="COMBOWICK", Description="Cooldown finished! Re-execute.", Time=4})
        end)

    elseif result.status == "throttled" then
        local remaining = tonumber(result.remaining) or 0
        statusLabel:SetText("Throttled")
        hintLabel:SetText("Too many requests. Please wait.")
        Library:Notify({Title="COMBOWICK", Description="Throttled. Wait a moment.", Time=5})
        task.spawn(function()
            while remaining > 0 do
                timerLabel:SetText(string.format("Retry in: %s", formatTime(remaining)))
                task.wait(1)
                remaining -= 1
            end
            timerLabel:SetText("Ready. Re-execute.")
            hintLabel:SetText("")
        end)

    elseif result.status == "disabled" then
        statusLabel:SetText("Service Paused")
        hintLabel:SetText("COMBOWICK is temporarily offline.")
        Library:Notify({Title="COMBOWICK", Description="Service disabled. Try later.", Time=6})

    elseif result.status == "banned" then
        statusLabel:SetText("Banned")
        Library:Notify({Title="COMBOWICK", Description="You are banned.", Time=5})

    else
        statusLabel:SetText("Error")
        Library:Notify({Title="COMBOWICK", Description=tostring(result.message), Time=5})
    end
end)

