-- ─── step 1: premium key check ───────────────────────────────────

local whitelisted, matchData, errorType = VaultModule.isClientIdWhitelisted(hwid, encryptedHWID)

if whitelisted then
    local versionValid, versionMsg, fetchedToken = VaultModule.checkVersionAndToken()
    if versionValid then
        _G.VaultInitialized  = true
        _G.VaultVersionToken = fetchedToken
        VaultModule.startSessionMonitoring(hwid)
        getgenv().VaultReady = true
        execPremiumScript()
        return
    end
    -- version failed → fall through to free tier
    whitelisted = false
end

-- ─── step 2: free session fast-path ──────────────────────────────

local preCheck = checkSession(hwid)
if preCheck == nil or preCheck.status == "game_not_allowed" then return end

if preCheck.status == "session_active" then
    local token = preCheck.session_token
    if type(token) == "string" and #token >= 20 then
        local scriptUrl = getScriptForGame(token)
        if loadFreeScript(scriptUrl, token) then return end
    end
end

-- ─── step 3: unified GUI ─────────────────────────────────────────

do
    local guiName = "LinoriaGui"
    local target  = gethui and gethui() or game:GetService("CoreGui")
    for _, v in ipairs(target:GetChildren()) do
        if v.Name == guiName then pcall(v.Destroy, v) end
    end
    if gethui then
        for _, v in ipairs(game:GetService("CoreGui"):GetChildren()) do
            if v.Name == guiName then pcall(v.Destroy, v) end
        end
    end
end

