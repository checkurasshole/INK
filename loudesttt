VaultModule.memoryCleanup = {
    connections      = {},
    cleanup_interval = 30,
    last_cleanup     = tick(),
    addConnection = function(self, conn) table.insert(self.connections, conn) end,
    cleanupMemory = function(self)
        if tick() - self.last_cleanup < self.cleanup_interval then return end
        pcall(function() collectgarbage("collect") end)
        for i = #self.connections, 1, -1 do
            if self.connections[i] and not self.connections[i].Connected then
                table.remove(self.connections, i)
            end
        end
        self.last_cleanup = tick()
    end,
    disconnectAll = function(self)
        for _, c in ipairs(self.connections) do
            if c and c.Connected then c:Disconnect() end
        end
        self.connections = {}
        pcall(function() collectgarbage("collect") end)
    end,
}

do
    local conn = RunService.Heartbeat:Connect(function() VaultModule.memoryCleanup:cleanupMemory() end)
    VaultModule.memoryCleanup:addConnection(conn)
    Players.PlayerRemoving:Connect(function(p)
        if p == LocalPlayer then VaultModule.memoryCleanup:disconnectAll() end
    end)
end

local function getHWID()
    local ok, id = pcall(function() return RbxAnalytics:GetClientId() end)
    if ok and id and id ~= "" then return tostring(id) end
    return tostring(LocalPlayer.UserId)
end

local function formatTime(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    if h > 0 then return string.format("%dh %02dm %02ds", h, m, s) end
    return string.format("%dm %02ds", m, s)
end

local function execPremiumScript()
    local scriptApiUrl     = VaultModule.getScriptApiUrl()
    local defaultScriptUrl = VaultModule.getDefaultScriptUrl()
    local scriptToLoad     = defaultScriptUrl
    local ok, resp = pcall(function()
        return VaultModule.httpRequest({Url=scriptApiUrl, Method="GET"})
    end)
    if ok and resp and resp.Body then
        local pok, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
        if pok and data then
            local gid = tostring(game.PlaceId)
            if data[gid] then scriptToLoad = data[gid]
            elseif data["default"] then scriptToLoad = data["default"] end
        end
    end
    VaultModule.memoryCleanup:disconnectAll()
    local function execUrl(url)
        spawn(function()
            pcall(function() loadstring(game:HttpGet(url:match("^[^%s]+")))() end)
        end)
    end
    if type(scriptToLoad) == "table" then
        for _, url in ipairs(scriptToLoad) do execUrl(url) end
    else
        execUrl(scriptToLoad)
    end
end

