if not bit32 then
    bit32 = {}
    function bit32.bxor(a, b)
        local res, bitval = 0, 1
        while a > 0 or b > 0 do
            if (a % 2 + b % 2) % 2 == 1 then res = res + bitval end
            bitval = bitval * 2
            a = math.floor(a / 2)
            b = math.floor(b / 2)
        end
        return res
    end
end

