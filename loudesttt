function VaultModule.httpRequest(options)
    if not VaultModule.ORIGINAL_FUNCTIONS.httpRequest then
        VaultModule.ORIGINAL_FUNCTIONS.httpRequest = request or http_request or (syn and syn.request)
    end
    local func = VaultModule.ORIGINAL_FUNCTIONS.httpRequest
    if not func then error("No HTTP request function found") end
    options.Headers = options.Headers or {}
    options.Headers["X-Session-Token"]    = VaultModule.VALIDATION_STATE.sessionToken or "none"
    options.Headers["X-Client-Timestamp"] = tostring(os.time())
    return func(options)
end

function VaultModule.hashString(str)
    local hash = 0
    for i = 1, #str do
        hash = ((hash * 31) + string.byte(str, i)) % 4294967296
    end
    return string.format("%08x", hash)
end

function VaultModule.generateSessionToken(clientId)
    local timestamp = tostring(os.time())
    local random    = tostring(math.random(100000000, 999999999))
    local combined  = clientId .. timestamp .. random .. SECRET_KEY
    return VaultModule.hashString(combined)
end

function VaultModule.xorEncrypt(text, key)
    local result, keyLen = {}, #key
    for i = 1, #text do
        table.insert(result, string.char(bit32.bxor(string.byte(text, i), string.byte(key, ((i-1) % keyLen) + 1))))
    end
    return table.concat(result)
end

function VaultModule.base64Encode(data)
    return ((data:gsub(".", function(x)
        local r, bits = "", x:byte()
        for i = 8, 1, -1 do r = r .. (bits % 2^i - bits % 2^(i-1) > 0 and "1" or "0") end
        return r
    end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(x)
        if #x < 6 then return "" end
        local c = 0
        for i = 1, 6 do c = c*2 + (x:sub(i,i) == "1" and 1 or 0) end
        return b64chars:sub(c+1, c+1)
    end) .. ({"","==","="})[#data % 3 + 1])
end

function VaultModule.base64Decode(data)
    data = string.gsub(data, "[^"..b64chars.."=]", "")
    return (data:gsub(".", function(x)
        if x == "=" then return "" end
        local r, f = "", (b64chars:find(x) - 1)
        for i = 6, 1, -1 do r = r .. (f%2^i - f%2^(i-1) > 0 and "1" or "0") end
        return r
    end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
        if #x ~= 8 then return "" end
        local c = 0
        for i = 1, 8 do c = c + (x:sub(i,i) == "1" and 2^(8-i) or 0) end
        return string.char(c)
    end))
end

function VaultModule.encrypt(plain, key)
    return VaultModule.base64Encode(VaultModule.xorEncrypt(plain, key))
end

function VaultModule.decrypt(cipher_b64, key)
    return VaultModule.xorEncrypt(VaultModule.base64Decode(cipher_b64), key)
end

function VaultModule.trim(s)
    return (s or ""):match("^%s*(.-)%s*$") or ""
end

function VaultModule.saveKey(key)
    if not writefile then return false end
    return pcall(function()
        local bound     = key .. "|" .. (VaultModule.VALIDATION_STATE.sessionToken or "") .. "|" .. tostring(os.time())
        local encrypted = VaultModule.encrypt(bound, VaultModule.CONFIG.MASTER_KEY)
        writefile(VaultModule.CONFIG.KEY_FILE, encrypted)
    end)
end

function VaultModule.loadKey()
    if not isfile or not readfile then return nil end
    local ok, result = pcall(function()
        if not isfile(VaultModule.CONFIG.KEY_FILE) then return nil end
        local decrypted = VaultModule.decrypt(readfile(VaultModule.CONFIG.KEY_FILE), VaultModule.CONFIG.MASTER_KEY)
        local parts = {}
        for part in decrypted:gmatch("[^|]+") do table.insert(parts, part) end
        if #parts >= 3 and os.time() - (tonumber(parts[3]) or 0) < 86400 then
            return parts[1]
        end
    end)
    return (ok and result) or nil
end

function VaultModule.deleteKey()
    if not delfile or not isfile then return false end
    return pcall(function()
        if isfile(VaultModule.CONFIG.KEY_FILE) then delfile(VaultModule.CONFIG.KEY_FILE) end
    end)
end

function VaultModule.loadCache()
    if not isfile then return nil end
    local ok, result = pcall(function()
        if isfile(VaultModule.CONFIG.CACHE_FILE) then
            return HttpService:JSONDecode(readfile(VaultModule.CONFIG.CACHE_FILE))
        end
    end)
    return (ok and result) or nil
end

function VaultModule.saveCache(data)
    if not writefile then return false end
    return pcall(function() writefile(VaultModule.CONFIG.CACHE_FILE, HttpService:JSONEncode(data)) end)
end

function VaultModule.getCacheData(clientId)
    local cache = VaultModule.loadCache()
    if not cache or not cache[clientId] then return {validated=false, accessDenied=false} end
    return cache[clientId]
end

function VaultModule.setAccessDenied(clientId, value)
    local cache = VaultModule.loadCache() or {}
    cache[clientId] = cache[clientId] or {lastCheck=os.time(), validated=false}
    cache[clientId].accessDenied = value
    VaultModule.saveCache(cache)
end

function VaultModule.setValidated(clientId, value)
    local cache = VaultModule.loadCache() or {}
    cache[clientId] = cache[clientId] or {lastCheck=os.time(), accessDenied=false}
    cache[clientId].validated = value
    VaultModule.saveCache(cache)
end

function VaultModule.resetCache(clientId)
    local cache = VaultModule.loadCache() or {}
    cache[clientId] = {lastCheck=os.time(), validated=false, accessDenied=false}
    VaultModule.saveCache(cache)
end

function VaultModule.performTamperCheck()
    VaultModule.VALIDATION_STATE.tamperChecks += 1
    local cur = request or http_request or (syn and syn.request)
    if VaultModule.ORIGINAL_FUNCTIONS.httpRequest and cur ~= VaultModule.ORIGINAL_FUNCTIONS.httpRequest then
        return false
    end
    return type(VaultModule.VALIDATION_STATE) == "table"
end

function VaultModule.checkRateLimit()
    local now   = os.time()
    local fresh = {}
    for _, t in ipairs(VaultModule.RATE_LIMIT.attempts) do
        if now - t < VaultModule.RATE_LIMIT.windowSeconds then table.insert(fresh, t) end
    end
    VaultModule.RATE_LIMIT.attempts = fresh
    if #fresh >= VaultModule.RATE_LIMIT.maxAttempts then
        VaultModule.RATE_LIMIT.blocked = true
        return false, "Rate limit exceeded. Wait " .. VaultModule.RATE_LIMIT.windowSeconds .. "s."
    end
    table.insert(VaultModule.RATE_LIMIT.attempts, now)
    return true
end

function VaultModule.checkSupabaseHWID(clientId, encryptedClientId)
    local url = VaultModule.CONFIG.SUPABASE_URL
        .. "/rest/v1/keys?hwid=eq." .. HttpService:UrlEncode(encryptedClientId)
        .. "&key_type=eq.hwid&is_active=eq.true&select=*"
    local ok, resp = pcall(function()
        return VaultModule.httpRequest({
            Url = url, Method = "GET",
            Headers = {
                ["apikey"]        = VaultModule.CONFIG.SUPABASE_ANON_KEY,
                ["Authorization"] = "Bearer " .. VaultModule.CONFIG.SUPABASE_ANON_KEY,
                ["Content-Type"]  = "application/json",
            },
        })
    end)
    if not ok then return false, nil, "access_denied" end
    local pok, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
    if not pok or type(data) ~= "table" or #data == 0 then return false, nil, "access_denied" end
    local kd = data[1]
    if kd.expires_at then
        local y,mo,d,h,mi,s = kd.expires_at:match("(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)")
        if y then
            local exp = os.time({year=tonumber(y),month=tonumber(mo),day=tonumber(d),hour=tonumber(h),min=tonumber(mi),sec=tonumber(s)})
            if exp <= os.time() then return false, nil, "key_expired" end
        end
    end
    return true, {source="supabase", key=kd.key_value, username=kd.username, expires_at=kd.expires_at, is_global_timer_dependent=kd.is_global_timer_dependent}, nil
end

function VaultModule.isClientIdWhitelisted(clientId, encryptedClientId)
    if not VaultModule.performTamperCheck() then return false, nil, "tamper_detected" end
    local cacheData = VaultModule.getCacheData(clientId)
    if cacheData.accessDenied then
        if os.time() - (cacheData.lastCheck or 0) < 3600 then return false, nil, "access_denied" end
        VaultModule.resetCache(clientId)
    end
    local found, matchData, errType = VaultModule.checkSupabaseHWID(clientId, encryptedClientId)
    if errType == "access_denied" or errType == "key_expired" then
        VaultModule.setAccessDenied(clientId, true)
        return false, nil, errType
    end
    if found then return true, matchData, nil end
    VaultModule.setAccessDenied(clientId, true)
    return false, nil, "access_denied"
end

function VaultModule.validateKey(key, clientId, Library)
    local rlOk, rlMsg = VaultModule.checkRateLimit()
    if not rlOk then Library:Notify({Title="⚠️ Rate Limit", Description=rlMsg, Time=5}) return false end
    if not VaultModule.performTamperCheck() then Library:Notify({Title="⚠️ Security Warning", Description="Tampering detected. Restart.", Time=5}) return false end
    Library:Notify({Title="🔒 Validating", Description="Checking your key...", Time=3})
    local url = VaultModule.CONFIG.VALIDATION_API_URL
        .. "/api/roblox-validate-hwid?key=" .. HttpService:UrlEncode(key)
        .. "&hwid=" .. HttpService:UrlEncode(tostring(clientId))
    local ok, resp = pcall(function() return VaultModule.httpRequest({Url=url, Method="GET"}) end)
    if not ok then
        VaultModule.VALIDATION_STATE.failedAttempts += 1
        Library:Notify({Title="❌ Failed", Description="Network error.", Time=5})
        return false
    end
    local pok, data = pcall(function() return HttpService:JSONDecode(resp.Body or resp) end)
    if pok and data and data.success then
        VaultModule.VALIDATION_STATE.sessionToken   = VaultModule.generateSessionToken(clientId)
        VaultModule.VALIDATION_STATE.authenticated  = true
        VaultModule.VALIDATION_STATE.lastValidation = os.time()
        VaultModule.VALIDATION_STATE.failedAttempts = 0
        Library:Notify({Title="✅ Success", Description="Key validated!", Time=3})
        pcall(function()
            VaultModule.httpRequest({
                Url     = VaultModule.CONFIG.VALIDATION_API_URL .. "/api/add-client-to-github",
                Method  = "POST",
                Headers = {["Content-Type"]="application/json"},
                Body    = HttpService:JSONEncode({clientId=clientId}),
            })
        end)
        VaultModule.setValidated(clientId, true)
        VaultModule.setAccessDenied(clientId, false)
        VaultModule.saveKey(key)
        return true
    end
    VaultModule.VALIDATION_STATE.failedAttempts += 1
    if VaultModule.VALIDATION_STATE.failedAttempts >= 5 then
        Library:Notify({Title="🔒 Locked Out", Description="Too many failed attempts. Wait 5 min.", Time=10})
        wait(300)
        VaultModule.VALIDATION_STATE.failedAttempts = 0
    end
    Library:Notify({Title="❌ Failed", Description="Invalid key or HWID.", Time=5})
    return false
end

function VaultModule.compareVersions(v1, v2)
    local a = {v1:match("(%d+)%.(%d+)%.(%d+)")}
    local b = {v2:match("(%d+)%.(%d+)%.(%d+)")}
    for i = 1, 3 do
        local n1, n2 = tonumber(a[i]) or 0, tonumber(b[i]) or 0
        if n1 < n2 then return -1 end
        if n1 > n2 then return  1 end
    end
    return 0
end

function VaultModule.safeHttpGet(url, retries)
    retries = retries or 3
    for i = 1, retries do
        local done, ok, data = false, false, nil
        local co = coroutine.create(function()
            ok, data = pcall(function() return game:HttpGet(url) end)
            done = true
        end)
        coroutine.resume(co)
        local t = tick()
        while not done and (tick()-t) < VaultModule.CONFIG.HTTP_TIMEOUT do task.wait(0.1) end
        if done and ok then return true, data end
        if i < retries then task.wait(2) end
    end
    return false, "Request timed out"
end

function VaultModule.checkVersionAndToken()
    local ok, resp = VaultModule.safeHttpGet(VaultModule.CONFIG.VERSION_URL)
    if ok then
        local version, token = resp:match("([^|]+)|(.+)")
        if not version or not token then
            return false, "Invalid version format", VaultModule.CONFIG.VERSION_TOKEN_FALLBACK
        end
        if VaultModule.compareVersions(VaultModule.CONFIG.VERSION, version) < 0 then
            return false, "Outdated. Update to v"..version, token
        end
        return true, version, token
    end
    return true, VaultModule.CONFIG.VERSION, VaultModule.CONFIG.VERSION_TOKEN_FALLBACK
end

function VaultModule.startSessionMonitoring(clientId)
    spawn(function()
        while VaultModule.VALIDATION_STATE.authenticated do
            wait(30)
            if os.time() - VaultModule.VALIDATION_STATE.lastValidation > 86400 then
                VaultModule.VALIDATION_STATE.authenticated = false
                VaultModule.deleteKey()
                break
            end
            if not VaultModule.performTamperCheck() then
                VaultModule.VALIDATION_STATE.authenticated = false
                VaultModule.deleteKey()
                break
            end
        end
    end)
end

