local function toggle(label, flag)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 36)
    btn.BorderSizePixel = 0
    btn.TextColor3 = Color3.fromRGB(190, 190, 190)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Text = "  ○  " .. label
    btn.LayoutOrder = order
    btn.Parent = win
    order += 1
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(function()
        flags[flag] = not flags[flag]
        local on = flags[flag]
        btn.Text = on and ("  ●  " .. label) or ("  ○  " .. label)
        btn.TextColor3 = on and Color3.fromRGB(160, 100, 255) or Color3.fromRGB(190, 190, 190)
        btn.BackgroundColor3 = on and Color3.fromRGB(35, 18, 70) or Color3.fromRGB(22, 22, 36)
    end)
    return btn
end

local function action(label, fn)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(90, 40, 210)
    btn.BorderSizePixel = 0
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Text = "  ▶  " .. label
    btn.LayoutOrder = order
    btn.AutoButtonColor = false
    btn.Parent = win
    order += 1
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(120, 60, 255)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(90, 40, 210)}):Play()
    end)
    btn.MouseButton1Click:Connect(fn)
    return btn
end

local function speedRow()
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 34)
    frame.BackgroundTransparency = 1
    frame.LayoutOrder = order
    frame.Parent = win
    order += 1

    local rowLayout = Instance.new("UIListLayout", frame)
    rowLayout.FillDirection = Enum.FillDirection.Horizontal
    rowLayout.Padding = UDim.new(0, 6)

    local speedLbl = Instance.new("TextLabel")
    speedLbl.Size = UDim2.new(0.5, -3, 1, 0)
    speedLbl.BackgroundColor3 = Color3.fromRGB(22, 22, 36)
    speedLbl.BorderSizePixel = 0
    speedLbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    speedLbl.Font = Enum.Font.GothamSemibold
    speedLbl.TextSize = 12
    speedLbl.Text = "Speed: " .. flags.speed
    speedLbl.Parent = frame
    Instance.new("UICorner", speedLbl).CornerRadius = UDim.new(0, 6)

    local function mkBtn(txt, delta)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.25, -3, 1, 0)
        b.BackgroundColor3 = Color3.fromRGB(90, 40, 210)
        b.BorderSizePixel = 0
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 14
        b.Text = txt
        b.Parent = frame
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        b.MouseButton1Click:Connect(function()
            flags.speed = math.clamp(flags.speed + delta, 16, MAX_SPEED_ALLOWED)
            speedLbl.Text = "Speed: " .. flags.speed
        end)
    end
    mkBtn("-", -10)
    mkBtn("+", 10)
end

