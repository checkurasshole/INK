local function getTrail(name)
    local ok, res = pcall(function()
        return BuyTrail:InvokeServer(name, "Wins")
    end)
    if ok then
        task.wait(0.4)
        pcall(function() EquipTrail:FireServer(name) end)
    else
        warn("Failed: " .. tostring(res))
    end
end

