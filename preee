local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"

local Library = loadstring(game:HttpGet(repo .. "Library.lua"))()
local ThemeManager = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
local SaveManager = loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()

local Options = Library.Options
local Toggles = Library.Toggles

local Window = Library:CreateWindow({
    Title = "COMBOWICK",
    Footer = "premium",
    NotifySide = "Right",
    ShowCustomCursor = false,
    AutoShow = true,
    Size = UDim2.fromOffset(500, 300),
})

local Tabs = {
    Main = Window:AddTab("Main", "user"),
    ["UI Settings"] = Window:AddTab("UI Settings", "settings"),
}

local MainGroup = Tabs.Main:AddLeftGroupbox("Main", "home")
MainGroup:AddToggle("ExampleToggle", {Text = "Example Toggle", Default = false})
MainGroup:AddButton({Text = "Example Button", Func = function() end})

local MenuGroup = Tabs["UI Settings"]:AddLeftGroupbox("Menu", "wrench")
MenuGroup:AddToggle("ShowCustomCursor", {Text = "Custom Cursor", Default = false, Callback = function(Value) Library.ShowCustomCursor = Value end})
MenuGroup:AddLabel("Menu bind"):AddKeyPicker("MenuKeybind", {Default = "RightShift", NoUI = true, Text = "Menu keybind"})

Library.ToggleKeybind = Options.MenuKeybind

ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)
SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({"MenuKeybind"})
ThemeManager:SetFolder("COMBOWICK")
SaveManager:SetFolder("COMBOWICK/game")
SaveManager:BuildConfigSection(Tabs["UI Settings"])
ThemeManager:ApplyToTab(Tabs["UI Settings"])
SaveManager:LoadAutoloadConfig()

local function showExpiredPopup(onDone)
	-- =============================================
	-- STEP 1: Kill all active features immediately
	-- using raw Roblox API so obfuscation doesn't
	-- interfere with module function calls
	-- =============================================
	forceCleanup()

	-- =============================================
	-- STEP 2: Build the popup UI from scratch
	-- (no Library dependency since it may already
	-- be tearing down when this is called)
	-- =============================================
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "CW_Expired"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	ScreenGui.Parent = game:GetService("CoreGui") -- CoreGui survives Library unload

	-- Main frame (starts offscreen above, tweens down)
	local Frame = Instance.new("Frame")
	Frame.Size = UDim2.fromOffset(280, 140)
	Frame.Position = UDim2.new(0.5, -140, 0, -150) -- hidden above screen
	Frame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
	Frame.BorderSizePixel = 0
	Frame.Parent = ScreenGui
	Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 14)

	-- Subtle border stroke
	local Stroke = Instance.new("UIStroke", Frame)
	Stroke.Color = Color3.fromRGB(80, 80, 100)
	Stroke.Thickness = 1

	-- Title label
	local Title = Instance.new("TextLabel", Frame)
	Title.Size = UDim2.new(1, -20, 0, 28)
	Title.Position = UDim2.fromOffset(10, 10)
	Title.BackgroundTransparency = 1
	Title.Text = "Free Session Ended"
	Title.TextColor3 = Color3.fromRGB(255, 255, 255)
	Title.TextSize = 14
	Title.Font = Enum.Font.GothamBold
	Title.TextXAlignment = Enum.TextXAlignment.Left

	-- Subtitle / instructions
	local Sub = Instance.new("TextLabel", Frame)
	Sub.Size = UDim2.new(1, -20, 0, 34)
	Sub.Position = UDim2.fromOffset(10, 36)
	Sub.BackgroundTransparency = 1
	Sub.Text = "Get a key at combowick.com\nto continue without cooldowns."
	Sub.TextColor3 = Color3.fromRGB(180, 180, 200)
	Sub.TextSize = 12
	Sub.Font = Enum.Font.Gotham
	Sub.TextXAlignment = Enum.TextXAlignment.Left
	Sub.TextWrapped = true

	-- Copy link button
	local Button = Instance.new("TextButton", Frame)
	Button.Size = UDim2.new(1, -20, 0, 24)
	Button.Position = UDim2.fromOffset(10, 74)
	Button.BackgroundColor3 = Color3.fromRGB(100, 100, 200)
	Button.BorderSizePixel = 0
	Button.Text = "Copy Key Link"
	Button.TextColor3 = Color3.fromRGB(255, 255, 255)
	Button.TextSize = 12
	Button.Font = Enum.Font.GothamBold
	Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 6)
	Button.MouseButton1Click:Connect(function()
		pcall(function() setclipboard("https://combowick.com/verify/provider-select") end)
		Button.Text = "Copied!"
		task.wait(1.5)
		Button.Text = "Copy Key Link"
	end)

	-- =============================================
	-- STEP 3: Countdown progress bar
	-- Shrinks from full width to 0 over 20 seconds
	-- visually showing the user how long they have
	-- =============================================
	local Bar = Instance.new("Frame", Frame)
	Bar.Size = UDim2.new(1, -20, 0, 3)
	Bar.Position = UDim2.fromOffset(10, 122)
	Bar.BackgroundColor3 = Color3.fromRGB(100, 100, 200)
	Bar.BorderSizePixel = 0
	Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)

	-- =============================================
	-- STEP 4: Animate popup sliding in from above
	-- =============================================
	Frame:TweenPosition(
		UDim2.new(0.5, -140, 0, 20), -- final position on screen
		Enum.EasingDirection.Out,
		Enum.EasingStyle.Quint,
		0.4,
		true
	)

	-- Shrink the bar over 20 seconds (the countdown)
	local ts = game:GetService("TweenService")
	ts:Create(Bar, TweenInfo.new(20, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 0, 3)
	}):Play()

	-- =============================================
	-- STEP 5: After 20 seconds, slide popup out
	-- then destroy it and fire onDone callback
	-- (onDone is what calls Library:Unload())
	-- =============================================
	task.delay(20, function()
		Frame:TweenPosition(
			UDim2.new(0.5, -140, 0, -150), -- slide back off screen
			Enum.EasingDirection.In,
			Enum.EasingStyle.Quint,
			0.4,
			true
		)
		task.wait(0.5)
		ScreenGui:Destroy()
		if onDone then onDone() end -- fires Library:Unload()
	end)
end

-- =============================================
-- If user has a valid key, disable free mode
-- and clear the key flag so it's not reused
-- =============================================
if _G.COMBOWICK_KEY then
	_G.COMBOWICK_FREE   = false
	_G.COMBOWICK_ACTIVE = nil
	_G.COMBOWICK_KEY    = false
end

-- =============================================
-- If running in free mode, start the session
-- timer — waits until COMBOWICK_ACTIVE is set
-- to false externally, then shows the popup
-- which cleans up everything and unloads
-- =============================================
if _G.COMBOWICK_FREE then
	_G.COMBOWICK_ACTIVE = true
	task.spawn(function()
		repeat task.wait(1) until _G.COMBOWICK_ACTIVE == false
		showExpiredPopup(function()
			Library:Unload()
		end)
	end)
end