local function startHealthUpgrade()
	autoHealthLoop = task.spawn(function()
		while _Toggles.AutoHealthUpgrade.Value do
			if HealthUpgradeRemote then pcall(function() HealthUpgradeRemote:FireServer() end) end
			task.wait(_Options.HealthUpgradeDelay.Value)
		end
	end)
end

local function stopHealthUpgrade()
	if autoHealthLoop then task.cancel(autoHealthLoop) autoHealthLoop = nil end
