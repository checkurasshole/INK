local function startAutoBuy()
	autoBuyLoop = task.spawn(function()
		while _Toggles.AutoBuyGear.Value do
			if GearPurchaseRemote then
				for gear, enabled in pairs(_Options.GearBuySelect.Value) do
					if enabled then
						pcall(function() GearPurchaseRemote:FireServer(gear) end)
						task.wait(0.05)
					end
				end
			end
			task.wait(_Options.GearBuyDelay.Value)
		end
	end)
end

local function stopAutoBuy()
	if autoBuyLoop then task.cancel(autoBuyLoop) autoBuyLoop = nil end
end

local function startNoclip()
	noclipLoop = RunService.Stepped:Connect(function()
		local char = LP.Character
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = false end
			end
		end
	end)
end

local function stopNoclip()
	if noclipLoop then noclipLoop:Disconnect() noclipLoop = nil end
	local char = LP.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = true end
		end
	end
end

local function enableAntiAFK()
	if getconnections then
		for _, connection in pairs(getconnections(LP.Idled)) do
			if connection["Disable"] then
				connection["Disable"](connection)
			elseif connection["Disconnect"] then
				connection["Disconnect"](connection)
			end
		end
	else
		LP.Idled:Connect(function()
			local vu = game:GetService("VirtualUser")
			vu:CaptureController()
			vu:ClickButton2(Vector2.new())
		end)
	end
end

local function setWalkSpeed(value)
	local char = LP.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = value end
	end
end

function M.init(Toggles, Options)
	_Toggles = Toggles
	_Options  = Options

	task.spawn(function()
		local ls = LP:WaitForChild("leaderstats")
		killsStat = ls:WaitForChild("Kills")
	end)

	task.spawn(function() ZombieDamageRemote  = RS:WaitForChild("ZombieRemotes"):WaitForChild("ZombieDamage") end)
	task.spawn(function() GunHitRemote        = RS:WaitForChild("GunRemotes"):WaitForChild("GunHit") end)
	task.spawn(function() SkipVoteRemote      = RS:WaitForChild("WaveRemotes"):WaitForChild("SkipVote") end)
	task.spawn(function() WeaponUpgradeRemote = RS:WaitForChild("UpgradeRemotes", 9e9):WaitForChild("PurchaseWeaponUpgrade", 9e9) end)
	task.spawn(function() HealthUpgradeRemote = RS:WaitForChild("UpgradeRemotes"):WaitForChild("PurchaseHealthUpgrade") end)
	task.spawn(function() GearPurchaseRemote  = RS:WaitForChild("GearRemotes"):WaitForChild("GearPurchase") end)
	task.spawn(function()
		local gsr = RS:WaitForChild("GameStateRemotes")
		DoubleCreditsRemote = gsr:WaitForChild("DoubleCreditsRequest", 9e9)
	end)

	task.spawn(function()
		local GameStateRemotes = RS:WaitForChild("GameStateRemotes")
		GameStateRemotes:WaitForChild("GameOverCredits").OnClientEvent:Connect(function(data)
			if type(data) ~= "table" then return end
			sessionTotal += data.TotalCredits
			if data.Multiplier and data.Multiplier ~= currentMultiplier then
				currentMultiplier = data.Multiplier
			end
			if _Toggles.AutoDoubleCredits.Value and DoubleCreditsRemote then
				task.wait(0.5)
				pcall(function() DoubleCreditsRemote:FireServer() end)
			end
		end)
		GameStateRemotes:WaitForChild("DoubleCreditsResult").OnClientEvent:Connect(function(data)
			if type(data) == "table" and data.Success then
				sessionTotal += data.DoubledTotal - (data.DoubledTotal / 2)
			end
		end)
	end)

	LP.CharacterAdded:Connect(function(char)
		flyFloating = false flyBaseHeight = 0 flyBodyVelocity = nil flyLoop = nil
		invis_on = false
		currentSeat = nil
		currentSeatPosition = nil
		stopSeatReturnHeartbeat()
		pcall(function() if _Toggles.EnableFly.Value    then _Toggles.EnableFly:SetValue(false)    end end)
		pcall(function() if _Toggles.Noclip.Value       then _Toggles.Noclip:SetValue(false)       end end)
		pcall(function() if _Toggles.InvisEnabled.Value then _Toggles.InvisEnabled:SetValue(false) end end)
		local hum = char:WaitForChild("Humanoid", 5)
		if hum then
			if _Options.WalkSpeed then hum.WalkSpeed = _Options.WalkSpeed.Value end
		end
	end)
end

function M.getZombieCount() return getZombieCount() end
function M.getEstCredits()  return getEstCredits()  end
function M.getSessionTotal() return sessionTotal    end

function M.updateESP()
	if not _Toggles.ZombieESP.Value then return end
	local folder = workspace:FindFirstChild("Zombies_Local")
	if not folder then M.clearESP() return end
	for zombie, h in pairs(espTable) do
		if not zombie.Parent then
			pcall(function() h:Destroy() end)
			espTable[zombie] = nil
		end
	end
	local fillColor = M.ESP_COLORS[_Options.ESPColor.Value] or M.ESP_COLORS.Red
	for _, zombie in ipairs(folder:GetChildren()) do
		if zombie:IsA("Model") and not espTable[zombie] then
			local h = Instance.new("Highlight")
			h.FillColor           = fillColor
			h.OutlineColor        = Color3.fromRGB(255, 255, 255)
			h.FillTransparency    = 0.45
			h.OutlineTransparency = 0
			h.Adornee             = zombie
			h.Parent              = zombie
			espTable[zombie]      = h
		end
	end
end

function M.clearESP()
	for _, h in pairs(espTable) do pcall(function() h:Destroy() end) end
	espTable = {}
end

function M.applyESPColor(color)
	for _, h in pairs(espTable) do h.FillColor = color end
end

function M.cleanup()
	if autoKillLoop      then task.cancel(autoKillLoop)                end
	if instaKillLoop     then task.cancel(instaKillLoop)               end
	if skipLoop          then task.cancel(skipLoop)                    end
	if autoWeaponUpgLoop then task.cancel(autoWeaponUpgLoop)           end
	if autoHealthLoop    then task.cancel(autoHealthLoop)              end
	if autoBuyLoop       then task.cancel(autoBuyLoop)                 end
	if noclipLoop        then noclipLoop:Disconnect() noclipLoop = nil end
	stopFly()
	disableInvisibility()
	M.clearESP()
	local pchar = LP.Character
	if pchar then
		for _, part in ipairs(pchar:GetDescendants()) do
			if part:IsA("BasePart") then part.CanCollide = true end
		end
		local hum = pchar:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = 16 hum.JumpPower = 50 end
	end
end

